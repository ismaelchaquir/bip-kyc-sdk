{
  "name": "@bipdelivery/core",
  "version": "0.4.0",
  "description": "UI-agnostic core SDK for the Bip KYC verification API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismaelchaquir/bip-kyc-sdk.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.mjs",
    "require": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^9.25.0",
    "tsup": "^8.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11"
  }
}
