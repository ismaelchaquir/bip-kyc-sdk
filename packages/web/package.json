{
  "name": "@bipdelivery/web",
  "version": "0.2.0",
  "description": "Browser capture for kyc-mz: the active liveness challenge and the full web verification flow, on MediaPipe.",
  "files": [
    "dist",
    "LIVENESS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rollup -c --bundleConfigAsCjs",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "playground": "vite",
    "playground:build": "vite build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@bipdelivery/core": "workspace:*",
    "@mediapipe/tasks-vision": "^1.0.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^8.54.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.0.0",
    "rollup-plugin-dts": "^6.0.0",
    "tslib": "^2.0.0",
    "typescript": "^5.3.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
